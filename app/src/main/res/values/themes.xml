<resources>
    <style name="Theme.MadreseyarTeacher" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#F6F8FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F6F8FC</item>
    </style>
    <style name="Theme.MadreseyarTeacher.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#075CE8</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MadreseyarTeacher</item>
    </style>
</resources>
